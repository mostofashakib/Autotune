# Autotune credentials. Copy to .env and replace each placeholder you need.
# A credential left at mock_key counts as not configured: the feature that
# needs it refuses to run and names the variable.

# Renting cloud GPUs on RunPod (autotune cloud, the Cloud GPUs tab).
RUNPOD_API_KEY=mock_key

# Downloading gated Hugging Face base models such as meta-llama/* for training.
HF_TOKEN=mock_key

# Model servers used by benchmarks and the playground are passed per run.
# Name the env var that holds each server's key with --base-key-env,
# --trained-key-env, or --judge-key-env (or api_key_env in the API), for example:
# TRAINED_SERVER_KEY=mock_key
