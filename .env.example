# Autotune credentials. Copy to .env and replace each placeholder you need.
# A credential left at mock_key counts as not configured: the feature that
# needs it refuses to run and names the variable.

# Renting cloud GPUs on RunPod (autotune cloud, the Cloud GPUs tab).
RUNPOD_API_KEY=mock_key

# Downloading gated Hugging Face base models such as meta-llama/* for training.
HF_TOKEN=mock_key

# Model servers used by benchmarks and the playground are passed per run.
# Name the env var that holds each server's key with --base-key-env,
# --trained-key-env, or --judge-key-env (or api_key_env in the API), for example:
# TRAINED_SERVER_KEY=mock_key

# Documents: install with uv sync --extra documents. Start a real local model first.
# Required: exact served model name (for example the name shown by ollama list).
AUTOTUNE_DOCUMENT_MODEL=
AUTOTUNE_DOCUMENT_ENDPOINT=http://localhost:11434/v1
# Optional: NAME of the environment variable containing the generator API key.
# Blank for unauthenticated local Ollama. A named key set to mock_key is rejected.
AUTOTUNE_DOCUMENT_API_KEY_ENV=
AUTOTUNE_DOCUMENT_CHUNK_TOKENS=800
AUTOTUNE_DOCUMENT_OVERLAP_TOKENS=100
AUTOTUNE_DOCUMENT_MAX_CHUNKS=200
AUTOTUNE_DOCUMENT_MIN_PAIR_TOKENS=8
AUTOTUNE_DOCUMENT_MAX_PAIR_TOKENS=1024
